{
  "info": {
    "_postman_id": "a8ad0e1c-8ec8-49ad-a313-72c9a89d4b50",
    "name": "Able Lubes Inventory & Billing API",
    "description": "Postman collection generated from the Express route definitions in src/routes/v1.ts and the feature route files. It includes each currently implemented endpoint and CRUD requests where supported. Sales and purchases do not use a request deduplication key, so retrying after a timeout can create another transaction. Unsupported hard DELETE, PUT, and invoice-read routes are documented instead of represented as working requests. Set adminPassword to ADMIN_PASSWORD from .env, seed the admin, start the API, then run folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
