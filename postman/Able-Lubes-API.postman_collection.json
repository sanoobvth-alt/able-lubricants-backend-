  "item": [
    {
      "name": "0. Health",
      "description": "Public GET /health route.",
      "item": [
        {
          "name": "API health check",
          "request": {
            "method": "GET",
            "url": "{{healthUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API health check', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication",
      "description": "POST login and admin-only POST staff-user creation. Login saves the bearer token for later requests.",
      "item": [
        {
          "name": "Login as seeded admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Token is returned', function () { pm.expect(body.data.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Create staff user (admin only)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Dummy Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"DummyStaffPass123!\",\n  \"role\": \"STAFF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('staffEmail', 'postman.staff.' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin creates a staff user', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().data.role).to.eql('STAFF'); });"
                ]
              }
            }
          ]
        }
      ]
    },
